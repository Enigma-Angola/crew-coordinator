# Copy to .env for local development. Never commit real secrets.
NODE_ENV=development
APP_BASE_URL=http://localhost:5173
DATABASE_URL=postgres://cc_app_login:cc_app_dev@localhost:5432/crew_coordinator
MIGRATION_DATABASE_URL=postgres://postgres@localhost:5432/crew_coordinator

# Identity providers (OIDC). In production use your maintained IdP (Keycloak, Entra ID, Okta, Auth0),
# over https, with MFA policies configured there. mfaAmr lists the "amr" values the IdP uses for MFA.
OIDC_PROVIDERS=[{"id":"dev","name":"Development IdP","issuer":"http://localhost:4000","clientId":"crew-coordinator","clientSecret":"dev-secret"}]

# 32 random bytes, base64 (e.g. `openssl rand -base64 32`). Required in production; keep in a secret manager.
TOKEN_ENCRYPTION_KEY=
URL_SIGNING_KEY=

STORAGE_DIR=./var/storage
# clamav (recommended) | none (files stay quarantined) | dev-allow-all (development only, refused in production)
MALWARE_SCAN_MODE=dev-allow-all
CLAMAV_HOST=127.0.0.1
CLAMAV_PORT=3310

# Microsoft 365 / Graph connector (Entra ID app registration, delegated permissions:
# offline_access User.Read Mail.Read Mail.Send [+ Mail.Read.Shared Mail.Send.Shared for shared mailboxes]).
MS_CLIENT_ID=
MS_CLIENT_SECRET=
MS_TENANT=organizations

# Optional AI provider. Nothing is sent unless an administrator also approves it per workspace.
ANTHROPIC_API_KEY=
